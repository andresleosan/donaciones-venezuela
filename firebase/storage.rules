rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isCategory(category) {
      return category == 'receipts'
        || category == 'needs'
        || category == 'reports'
        // Cedula del responsable y foto del sitio de un centro (panel_crear).
        || category == 'centers'
        // Cedula de un voluntario y placa/vehiculo/cedula de un transportista.
        || category == 'volunteers'
        || category == 'drivers'
        // Fotos del insumo ofrecido, de quien lo ofrece y de la recogida.
        || category == 'offers'
        // `deliveries`: fotos del ciclo logistico (el local, el cargamento y
        // quien recibe en el centro). Cerradas como `offers`.
        || category == 'deliveries'
        // `families`: fotos de la vivienda destruida de una familia damnificada.
        || category == 'families';
    }

    // Exactamente las tres claves del contrato: sin canal de datos libre en metadata.
    function hasPrivateMetadata(uid, category) {
      return request.resource.metadata.keys().hasOnly(['ownerUid', 'category', 'visibility'])
        && request.resource.metadata.keys().hasAll(['ownerUid', 'category', 'visibility'])
        && request.resource.metadata.ownerUid == uid
        && request.resource.metadata.category == category
        && request.resource.metadata.visibility == 'private';
    }

    function isAllowedFile(fileName) {
      return fileName.matches('^[A-Za-z0-9][A-Za-z0-9_-]*\\.(jpg|jpeg|png|webp|pdf|webm|mp4)$');
    }

    // El video (30 MB) solo cabe en `reports`, la denuncia. Sin esa condicion,
    // cada formulario con foto seria un canal de subida de video.
    function isAllowedContent(category, fileName) {
      return request.resource.size > 0
        && ((fileName.matches('^[A-Za-z0-9][A-Za-z0-9_-]*\\.(jpg|jpeg|png|webp)$')
          && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
          && request.resource.size <= 5 * 1024 * 1024)
        || (fileName.matches('^[A-Za-z0-9][A-Za-z0-9_-]*\\.pdf$')
          && request.resource.contentType == 'application/pdf'
          && request.resource.size <= 10 * 1024 * 1024)
        || (category == 'reports'
          && fileName.matches('^[A-Za-z0-9][A-Za-z0-9_-]*\\.(webm|mp4)$')
          && request.resource.contentType in ['video/webm', 'video/mp4']
          && request.resource.size <= 30 * 1024 * 1024));
    }

    // Una actualizacion solo puede tocar metadata: el contenido ya revisado no se sustituye.
    function keepsContent() {
      return request.resource.size == resource.size
        && request.resource.md5Hash == resource.md5Hash
        && request.resource.contentType == resource.contentType;
    }

    match /private/{uid}/{category}/{fileName} {
      allow read, delete: if false;
      allow create: if resource == null
        && isOwner(uid)
        && isCategory(category)
        && isAllowedFile(fileName)
        && isAllowedContent(category, fileName)
        && hasPrivateMetadata(uid, category);
      allow update: if resource != null
        && isOwner(uid)
        && isCategory(category)
        && isAllowedFile(fileName)
        && isAllowedContent(category, fileName)
        && hasPrivateMetadata(uid, category)
        && keepsContent();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
