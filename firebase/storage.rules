rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isCategory(category) {
      return category == 'receipts'
        || category == 'needs'
        || category == 'reports'
        // Cedula del responsable y foto del sitio de un centro (panel_crear).
        || category == 'centers'
        // Cedula de un voluntario y placa/vehiculo/cedula de un transportista.
        || category == 'volunteers'
        || category == 'drivers';
    }

    // Exactamente las tres claves del contrato: sin canal de datos libre en metadata.
    function hasPrivateMetadata(uid, category) {
      return request.resource.metadata.keys().hasOnly(['ownerUid', 'category', 'visibility'])
        && request.resource.metadata.keys().hasAll(['ownerUid', 'category', 'visibility'])
        && request.resource.metadata.ownerUid == uid
        && request.resource.metadata.category == category
        && request.resource.metadata.visibility == 'private';
    }

    function isAllowedFile(fileName) {
      return fileName.matches('^[A-Za-z0-9][A-Za-z0-9_-]*\\.(jpg|jpeg|png|webp|pdf)$');
    }

    function isAllowedContent(fileName) {
      return request.resource.size > 0
        && ((fileName.matches('^[A-Za-z0-9][A-Za-z0-9_-]*\\.(jpg|jpeg|png|webp)$')
          && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
          && request.resource.size <= 5 * 1024 * 1024)
        || (fileName.matches('^[A-Za-z0-9][A-Za-z0-9_-]*\\.pdf$')
          && request.resource.contentType == 'application/pdf'
          && request.resource.size <= 10 * 1024 * 1024));
    }

    // Una actualizacion solo puede tocar metadata: el contenido ya revisado no se sustituye.
    function keepsContent() {
      return request.resource.size == resource.size
        && request.resource.md5Hash == resource.md5Hash
        && request.resource.contentType == resource.contentType;
    }

    match /private/{uid}/{category}/{fileName} {
      allow read, delete: if false;
      allow create: if resource == null
        && isOwner(uid)
        && isCategory(category)
        && isAllowedFile(fileName)
        && isAllowedContent(fileName)
        && hasPrivateMetadata(uid, category);
      allow update: if resource != null
        && isOwner(uid)
        && isCategory(category)
        && isAllowedFile(fileName)
        && isAllowedContent(fileName)
        && hasPrivateMetadata(uid, category)
        && keepsContent();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
