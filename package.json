{
  "name": "donaciones-venezuela",
  "private": true,
  "version": "0.0.0-migration",
  "type": "module",
  "description": "Plataforma de respuesta humanitaria Venezuela",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude \"tests/rules/**\" --exclude \"tests/emulators/**\"",
    "test:rules:run": "vitest run tests/rules",
    "test:rules": "node scripts/emulators-exec.mjs --project demo-donaciones-venezuela --only firestore,storage \"npm run test:rules:run\"",
    "test:functions:run": "vitest run tests/functions tests/emulators/health.integration.test.ts tests/emulators/auth.integration.test.ts tests/emulators/volunteer-consent.integration.test.ts tests/emulators/api.integration.test.ts tests/emulators/api-lugares.integration.test.ts tests/emulators/api-personas.integration.test.ts tests/emulators/api-vacantes.integration.test.ts tests/emulators/api-facturas.integration.test.ts tests/emulators/api-presupuestos.integration.test.ts tests/emulators/api-viajes.integration.test.ts tests/emulators/api-denuncias.integration.test.ts tests/emulators/api-consola.integration.test.ts",
    "test:functions": "npm --prefix functions run build && node scripts/emulators-exec.mjs --project demo-donaciones-venezuela --only auth,firestore,functions \"npm run test:functions:run\"",
    "test:emulators:run": "vitest run tests/rules tests/functions tests/emulators",
    "test:emulators": "npm --prefix functions run build && node scripts/emulators-exec.mjs --project demo-donaciones-venezuela --only auth,firestore,storage,functions \"npm run test:emulators:run\"",
    "seed:emulador": "npm --prefix functions run build && node scripts/emulators-exec.mjs --project demo-donaciones-venezuela --only auth,firestore --export-on-exit=./seeds/emulador \"node functions/scripts/semilla-firebase.mjs\"",
    "export:supabase": "node scripts/export-supabase.mjs",
    "export:supabase:dry-run": "node scripts/export-supabase.mjs --dry-run",
    "verify:export": "node scripts/verify-supabase-export.mjs",
    "verify": "npm run test:unit && npm run test:emulators && npm run build && npm audit --audit-level=high && npm audit --prefix functions --audit-level=high && python scripts/verificar-idioma.py"
  },
  "dependencies": {
    "firebase": "^12.16.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "fake-indexeddb": "6.2.5",
    "firebase-tools": "15.34.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js@>=1 <2": "1.14.5",
    "@modelcontextprotocol/sdk@>=1 <2": "1.32.0",
    "@vitest/mocker@>=4 <5": "4.1.12",
    "body-parser@>=2 <3": "2.4.0",
    "body-parser@>=1 <2": "1.20.9",
    "brace-expansion@>=1 <2": "1.1.21",
    "brace-expansion@>=2 <3": "2.1.7",
    "compression@>=1 <2": "1.8.2",
    "fast-uri@>=3 <4": "3.1.9",
    "hono@>=4 <5": "4.13.11",
    "ip-address@>=10 <11": "10.7.4",
    "js-yaml@>=4 <5": "4.3.2",
    "morgan@>=1 <2": "1.12.1",
    "proxy-addr@>=2 <3": "2.0.8",
    "qs@>=6 <7": "6.16.1",
    "source-map-js@>=1 <2": "1.2.2",
    "undici@>=8 <9": "8.12.2",
    "undici@>=6 <7": "6.29.1",
    "vitest@>=4 <5": "4.1.12",
    "zod@>=4 <5": "4.6.6",
    "uuid@>=9 <11": "11.1.1",
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "2.12.0"
    }
  }
}
